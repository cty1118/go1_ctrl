<?xml version="1.0"?>
<package format="2">
  <name>go1_ctrl</name>
  <version>0.1.0</version>
  <description>Self-written Go1 gait controller: walk, trot, canter, gallop with position + impedance control.</description>
  <maintainer email="todo@example.com">go1_ctrl team</maintainer>
  <license>BSD</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>gazebo_msgs</depend>
  <depend>unitree_legged_msgs</depend>
  <depend>eigen</depend>

  <exec_depend>unitree_gazebo</exec_depend>
  <exec_depend>unitree_legged_control</exec_depend>
  <exec_depend>go1_description</exec_depend>
  <exec_depend>rosbag</exec_depend>
</package>
